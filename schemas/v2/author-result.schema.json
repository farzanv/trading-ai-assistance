{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/farzanv/trading-ai-assistance/schemas/v2/author-result.schema.json",
  "title": "author-result/v2 — author output for the initial revision of a lane (architecture §7.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item", "commit", "scope_base", "revision", "tree_digest", "files_changed", "tests", "author"],
  "properties": {
    "schema_version": { "const": 2 },
    "work_item": { "type": "string" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "full SHA of the authored revision; must descend from scope_base" },
    "scope_base": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "the lane's immutable base, echoed verbatim" },
    "revision": { "type": "integer", "minimum": 1 },
    "tree_digest": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "git tree object id of the commit" },
    "files_changed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tests": {
      "type": "array",
      "description": "the focused commands the author ran; the verify worker re-runs the gate independently",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_ok"],
        "properties": {
          "command": { "type": "string" },
          "exit_ok": { "type": "boolean" },
          "summary": { "type": "string" }
        }
      }
    },
    "unknown_contracts": {
      "type": "array",
      "description": "provider/API questions neither agent can answer — each is a STOP packaged for the operator",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "endpoint", "question", "consulted", "would_settle"],
        "properties": {
          "provider": { "type": "string" },
          "endpoint": { "type": "string" },
          "question": { "type": "string" },
          "consulted": { "type": "array", "items": { "type": "string" } },
          "would_settle": { "type": "string" }
        }
      }
    },
    "dependencies_added": { "type": "array", "items": { "type": "string" } },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "enum": ["claude", "codex"] },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "session_id": { "type": "string" },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "cache_read": { "type": "integer", "minimum": 0 },
            "cache_write": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
